<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kervan" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sky</item>
        <item name="android:colorBackground">@color/sky</item>
    </style>

    <!-- Açılış ekranı: oyun yüklenene kadar gece gökyüzü üstünde deve -->
    <style name="Theme.Kervan.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Kervan</item>
    </style>
</resources>
